# The right-side AI conversation uses DeepSeek through OpenTopia's
# OpenAI-compatible provider adapter. Image and video generation use the
# separate ARK_* settings.
# Never put the key in a VITE_ variable or commit it.
# This is a reference file; cargo run and scripts/dev.ps1 do not load it automatically.
PLAYLETFLOW_LLM_BASE_URL=https://api.deepseek.com
PLAYLETFLOW_LLM_MODEL=deepseek-flash
PLAYLETFLOW_LLM_API_KEY=
VIDEOFLOW_DB=.videoflow/conversations.sqlite
VIDEOFLOW_PRODUCT_DB=.videoflow/product.sqlite

# Optional: enable image/video generation through Volcengine Ark. The key stays
# in the server process; never expose it through a VITE_ variable.
ARK_API_KEY=your-volcengine-ark-api-key
VIDEOFLOW_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEOFLOW_GENERATION_WATERMARK=false
VIDEOFLOW_MEDIA_DIR=.videoflow/media

# Cloud mode (VIDEOFLOW_CLOUD=1): TOS is required for workspace snapshots and
# proposals even when media generation is disabled. The same private bucket
# also holds generation jobs, reference frames and generated media.
# These are server-only values.
TOS_ACCESS_KEY=your-tos-access-key-id
TOS_SECRET_KEY=your-tos-secret-access-key
TOS_BUCKET=your-private-bucket
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# Optional upper bound for downloading one generated file before TOS upload.
VIDEOFLOW_GENERATION_MAX_DOWNLOAD_BYTES=536870912
