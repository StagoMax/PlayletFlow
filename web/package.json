{
  "name": "videoflow-runtime-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm contract:check && tsc --noEmit && vite build",
    "typecheck": "pnpm contract:check && tsc --noEmit",
    "typecheck:preview": "pnpm contract:check && tsc -p tsconfig.preview.json",
    "test:assets-proposals": "node scripts/test-assets-proposals.mjs",
    "test:preview": "node scripts/test-preview.mjs",
    "test:conversation-activity": "node scripts/test-conversation-activity.mjs",
    "test:e2e": "node scripts/run-e2e-specs.mjs",
    "test:acceptance": "cargo test --manifest-path ../server/Cargo.toml --locked && pnpm test:e2e",
    "contract:generate": "node scripts/generate-product-contract.mjs",
    "contract:check": "node scripts/generate-product-contract.mjs --check"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
